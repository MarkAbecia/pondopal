SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Legacy HS256 fallback; `supabase status` prints it locally
SUPABASE_JWT_SECRET=
# Server-only. Never ship this to the app.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://127.0.0.1:6379/0
# Optional: Sentry is enabled only when this is set
SENTRY_DSN=

# Optional: Expo push access token (needed if "enhanced push security" is on)
EXPO_ACCESS_TOKEN=

# Browser origins allowed to call the API (JSON list). Default is the Expo web dev server.
# CORS_ORIGINS=["http://localhost:8081"]
