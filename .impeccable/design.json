      "css": ".ds-seg{display:flex;padding:4px;border:2px solid #4F46E5;border-radius:9999px;background:#fff;width:280px}.ds-seg button{flex:1;min-height:44px;border:none;border-radius:9999px;background:transparent;color:#3730A3;font:600 14px system-ui,sans-serif;cursor:pointer}.ds-seg button.on{background:#4F46E5;color:#fff}.ds-seg button:active{opacity:.7}.ds-seg button:focus-visible{outline:3px solid #4F46E5;outline-offset:2px}"
