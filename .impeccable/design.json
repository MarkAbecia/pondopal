      "html": "<div class=\"ds-card\"><strong>Partner space</strong><span>₱19,474.50</span></div>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:8px;padding:20px;border-radius:24px;background:#fff;box-shadow:0 8px 18px rgba(59,42,140,.07);width:280px}.ds-card strong{font:700 18px system-ui,sans-serif;color:#1C1838}.ds-card span{font:800 30px Figtree,system-ui,sans-serif;font-variant-numeric:tabular-nums;color:#1C1838}"
    },
    {
      "name": "Gradient Header",
      "kind": "custom",
      "refersTo": "header-stat",
      "description": "The violet stage: note, BigMoney with small centavos, two glass stats.",
      "html": "<div class=\"ds-stage\"><span class=\"ds-note\">This month</span><div class=\"ds-big\">₱19,474<small>.50</small></div><div class=\"ds-stats\"><div class=\"ds-stat\"><span>Income</span><b>₱42,000.00</b></div><div class=\"ds-stat\"><span>Expense</span><b>₱22,525.50</b></div></div></div>",
      "css": ".ds-stage{background:linear-gradient(135deg,#7C3AED,#4F46E5);padding:16px 20px 28px;width:335px;font-family:system-ui,sans-serif}.ds-note{color:#EDE9FE;font-size:14px}.ds-big{color:#fff;font:800 40px/1.15 Figtree,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-big small{font-size:20px}.ds-stats{display:flex;gap:12px;margin-top:20px}.ds-stat{flex:1;display:flex;flex-direction:column;padding:12px;border-radius:16px;background:rgba(255,255,255,.16)}.ds-stat span{color:#EDE9FE;font-size:12px}.ds-stat b{color:#fff;font:700 16px Figtree,system-ui,sans-serif;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "PillBar",
      "kind": "custom",
      "refersTo": "pill-bar",
      "description": "Thick pill progress with the amount inside the fill and the limit at the end.",
      "html": "<div class=\"ds-pill\" role=\"progressbar\" aria-valuenow=\"64\"><div class=\"ds-fill\"></div><span class=\"ds-in\">₱3,200.00</span><span class=\"ds-max\">₱5,000.00</span></div>",
      "css": ".ds-pill{position:relative;display:flex;align-items:center;justify-content:space-between;height:36px;padding:0 12px;border-radius:9999px;background:#ECEAF5;overflow:hidden;width:280px;font:700 12px system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-fill{position:absolute;left:0;top:0;bottom:0;width:64%;border-radius:9999px;background:#4F46E5}.ds-in{position:relative;color:#fff}.ds-max{position:relative;color:#5F5A80;font-weight:600}"
