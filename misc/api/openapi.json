  "components": {
    "schemas": {
      "Balance": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "net_centavos": {
            "type": "integer",
            "title": "Net Centavos"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "display_name",
          "net_centavos"
        ],
        "title": "Balance"
      },
      "Challenge": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "space_id": {
            "type": "string",
            "format": "uuid",
            "title": "Space Id"
          },
          "template_key": {
            "type": "string",
            "title": "Template Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "base_centavos": {
            "type": "integer",
            "title": "Base Centavos"
          },
          "settings": {
            "additionalProperties": true,
            "type": "object",
            "title": "Settings"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "space_id",
          "template_key",
          "name",
          "base_centavos",
          "settings",
          "start_date",
          "status"
        ],
        "title": "Challenge"
      },
      "ChallengeCreate": {
        "properties": {
          "space_id": {
            "type": "string",
            "format": "uuid",
            "title": "Space Id"
          },
          "template_key": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Template Key"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "base_centavos": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Centavos"
          },
          "settings": {
            "$ref": "#/components/schemas/ChallengeSettings",
            "default": {
              "reverse": false,
              "leaderboard": false
            }
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          }
        },
        "type": "object",
        "required": [
          "space_id",
          "template_key",
          "name"
        ],
        "title": "ChallengeCreate"
      },
      "ChallengeProgress": {
        "properties": {
          "challenge": {
            "$ref": "#/components/schemas/Challenge"
          },
          "me": {
            "$ref": "#/components/schemas/MemberProgress"
          },
          "cells": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Cells"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/MemberProgress"
            },
            "type": "array",
            "title": "Members"
          }
        },
        "type": "object",
        "required": [
          "challenge",
          "me",
          "cells",
          "members"
        ],
        "title": "ChallengeProgress"
      },
      "ChallengeSettings": {
        "properties": {
          "reverse": {
            "type": "boolean",
            "title": "Reverse",
            "default": false
          },
          "target_bills": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Bills"
          },
          "target_centavos": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000000000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Centavos"
          },
          "leaderboard": {
            "type": "boolean",
            "title": "Leaderboard",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ChallengeSettings"
      },
      "ChallengeTemplate": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "rules": {
            "additionalProperties": true,
            "type": "object",
            "title": "Rules"
          }
        },
        "type": "object",
        "required": [
          "key",
          "name",
          "description",
          "rules"
        ],
        "title": "ChallengeTemplate"
      },
      "Entry": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "cell_index": {
            "type": "integer",
            "title": "Cell Index"
          },
          "amount_centavos": {
            "type": "integer",
            "title": "Amount Centavos"
          },
          "saved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Saved At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "cell_index",
          "amount_centavos",
          "saved_at"
        ],
        "title": "Entry"
      },
      "EntryCreate": {
        "properties": {
          "cell_index": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 365.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cell Index"
          },
          "bills": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Bills"
          },
          "amount_centavos": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000000000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Centavos"
          }
        },
        "type": "object",
        "title": "EntryCreate",
        "description": "Grid templates need cell_index; bill_50 needs bills; custom needs amount_centavos."
      },
      "Frequency": {
        "type": "string",
        "enum": [
          "daily",
          "weekly",
          "semi_monthly",
          "monthly"
        ],
        "title": "Frequency"
      },
      "GoalPlan": {
        "properties": {
          "goal_id": {
            "type": "string",
            "format": "uuid",
            "title": "Goal Id"
          },
          "target_centavos": {
            "type": "integer",
            "title": "Target Centavos"
          },
          "contributed_centavos": {
            "type": "integer",
            "title": "Contributed Centavos"
          },
          "remaining_centavos": {
            "type": "integer",
            "title": "Remaining Centavos"
          },
          "deadline": {
            "type": "string",
            "format": "date",
            "title": "Deadline"
          },
          "pay_frequency": {
            "type": "string",
            "title": "Pay Frequency"
