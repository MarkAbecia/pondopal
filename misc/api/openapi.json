    "/v1/paluwagan/{pal_id}/rounds/{n}/pay": {
      "post": {
        "tags": [
          "splits & paluwagan"
        ],
        "summary": "Pay Round",
        "description": "Mark a contribution as paid (or unpaid with \"paid\": false). Members mark their own;\nowners and admins can mark anyone's.",
        "operationId": "pay_round_v1_paluwagan__pal_id__rounds__n__pay_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "pal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Pal Id"
            }
          },
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "title": "N"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/PayIn"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paid"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
