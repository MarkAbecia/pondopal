        ],
        "summary": "Delete My Account",
        "description": "Deletes the account and personal data (RA 10173 right to erasure). Shared spaces you own\npass to another member; transactions you logged there stay, no longer linked to you.",
        "operationId": "delete_my_account_v1_me_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
